@startuml "activity_dia_01"

start
:Поступление заявки;
:Регистрация заявки;
if (Заявка корректна?) then (да)
  fork
    :Проверка данных;
  fork again
    :Проверка документов;
  end fork
  if (Проверки пройдены?) then (да)
    :Принятие заявки;
    :Уведомление заявителя;
  else (нет)
    :Отклонение заявки;
    :Уведомление заявителя об отказе;
  endif
else (нет)
  :Возврат заявки на уточнение;
endif
stop

@enduml
